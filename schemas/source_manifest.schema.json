{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenpulse.local/schemas/source_manifest.schema.json",
  "title": "GreenPulse AI source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "sources"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "isoDate": {"type": "string", "format": "date"},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"enum": ["m", "vector", "point", "native"]}
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "local_path", "checksum"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "checksum": {"anyOf": [{"$ref": "#/$defs/checksum"}, {"type": "null"}]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "scope", "source_organization", "product", "dataset_identifier",
        "license", "access_date", "scene_date_range", "geographic_coverage",
        "crs", "resolution", "checksum", "local_path", "verification_status",
        "data_classification", "format"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["required_mvp", "optional_mvp", "future_scope"]},
        "source_organization": {"type": ["string", "null"], "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "dataset_identifier": {"type": ["string", "null"], "minLength": 1},
        "license": {"type": ["string", "null"], "minLength": 1},
        "access_date": {"anyOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
        "scene_date_range": {
          "anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/isoDate"}, "end": {"$ref": "#/$defs/isoDate"}}},
            {"type": "null"}
          ]
        },
        "season_group": {"enum": ["peak_summer"]},
        "geographic_coverage": {"type": "string", "minLength": 1},
        "crs": {"type": ["string", "null"], "minLength": 1},
        "resolution": {"anyOf": [{"$ref": "#/$defs/resolution"}, {"type": "null"}]},
        "checksum": {"anyOf": [{"$ref": "#/$defs/checksum"}, {"type": "null"}]},
        "local_path": {"type": "string", "minLength": 1},
        "companion_files": {"type": "array", "items": {"$ref": "#/$defs/companion"}},
        "verification_status": {"enum": ["pending", "verified", "rejected"]},
        "data_classification": {"enum": ["real", "synthetic_test_fixture"]},
        "format": {
          "enum": ["geojson", "raster", "raster_directory", "landsat_l2sp_directory", "sentinel2_safe_directory", "parquet", "tabular"]
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"verification_status": {"const": "verified"}}},
          "then": {
            "properties": {
              "source_organization": {"type": "string", "minLength": 1},
              "dataset_identifier": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1},
              "access_date": {"$ref": "#/$defs/isoDate"},
              "scene_date_range": {"type": "object"},
              "crs": {"type": "string", "minLength": 1},
              "resolution": {"$ref": "#/$defs/resolution"},
              "checksum": {"$ref": "#/$defs/checksum"}
            }
          }
        }
      ]
    }
  }
}
